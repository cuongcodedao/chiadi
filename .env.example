# Chép file này thành .env.local rồi điền giá trị thật.
# Trên Vercel thì khai đúng những biến này trong Project Settings → Environment Variables.

# --- bắt buộc ---------------------------------------------------------------
# Local: Postgres 16 chạy sẵn trên cổng 5432.
# Neon:     postgresql://user:pass@ep-abc-123.ap-southeast-1.aws.neon.tech/chiadi?sslmode=require
# Supabase: dùng chuỗi "Connection pooling" cổng 6543, không phải cổng 5432.
DATABASE_URL="postgresql://postgres:MAT_KHAU@localhost:5432/chiadi"

# Tên miền thật, không có dấu / ở cuối. Thiếu biến này thì ảnh preview khi thả
# link vào Zalo/Messenger sẽ trỏ về localhost và nhóm chat không hiện gì.
# Trên Vercel có thể bỏ trống: mã tự lấy VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL="https://chiadi.vn"

# --- nên có trước khi mở cho người thật dùng --------------------------------
# Rate limit theo IP. Thiếu hai biến này thì bộ đếm chạy trong RAM, mỗi instance
# Vercel đếm một kiểu — tức là gần như không giới hạn gì.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
